# QueueOS
# Ignore build products, virtual-machine images, and local tool output.
# Source, documentation, and plans stay tracked.

# Build trees
/build/
/out/
/dist/

# Local test output. Run numbers and logs are not source.
/results/

# Compiler and linker output
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.d
*.su
*.map
*.lst
*.elf
*.efi
*.bin
*.exe
*.dll
*.so
*.dylib

# Boot and virtual-disk images
*.img
*.iso
*.qcow2
*.raw
*.vmdk
*.vdi
*.vhd
*.vhdx

# Firmware fetched for QEMU, not authored in this tree
/firmware/

# Crash dumps and debugger state
core
core.*
vgcore.*
*.dSYM/
.gdb_history

# Host-tool caches
.cache/
.clangd/
compile_commands.json
cscope.*
tags
TAGS
__pycache__/
*.pyc
.venv/
venv/
*.gcno
*.gcda
*.gcov
/coverage/

# Editor and OS debris
*~
*.swp
*.swo
.DS_Store
Thumbs.db
.directory
.idea/
.vscode/
*.code-workspace
